# ---------------------------------------------------------------------------
# Hasswell London — environment variables
# Copy to .env (local development) and configure the same names in Vercel.
# NEVER commit real values. NEVER prefix server-only secrets with VITE_.
# ---------------------------------------------------------------------------

# --- Public (safe to expose, consumed by the browser) ----------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_STORE_URL=https://YOUR_DOMAIN
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_SITE_VERIFICATION=

# --- Server only -----------------------------------------------------------
# Supabase service role — bypasses RLS. Server-side use only.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Base URL of the deployed site, used for redirects and canonical links.
PUBLIC_SITE_URL=https://YOUR_DOMAIN

# --- Payments --------------------------------------------------------------
# active provider: "manual" | "stripe"
PAYMENT_PROVIDER=manual
# Stripe (United Kingdom accounts supported; confirm eligibility first).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: restrict Stripe Checkout payment method types, comma separated.
STRIPE_PAYMENT_METHOD_TYPES=card

# Manual bank transfer details shown to customers when PAYMENT_PROVIDER=manual
MANUAL_PAYMENT_INSTRUCTIONS=
MANUAL_PAYMENT_ACCOUNT_NAME=
MANUAL_PAYMENT_SORT_CODE=
MANUAL_PAYMENT_ACCOUNT_NUMBER=

# --- Email -----------------------------------------------------------------
# active provider: "resend" | "log"
EMAIL_PROVIDER=log
EMAIL_FROM=orders@YOUR_DOMAIN
EMAIL_REPLY_TO=hello@YOUR_DOMAIN
RESEND_API_KEY=

# --- AW Dropship supplier --------------------------------------------------
# Manual/API channel token generated in AW Dropship: Channels > your channel > API.
AW_DROPSHIP_API_TOKEN=
# live: api.aiku.io   staging: api.aiku-sandbox.uk
AW_DROPSHIP_BASE_URL=https://api.aiku.io
# Master switch for order submission. Keep false until the flow has been
# verified end-to-end against the client's live AW account.
AW_DROPSHIP_ORDER_SUBMISSION_ENABLED=false
# Optional: fixed delivery option payload/fields required by the channel.
AW_DROPSHIP_DEFAULT_CARRIER=
AW_DROPSHIP_TIMEOUT_MS=20000

# --- Operations ------------------------------------------------------------
# Protects /api/cron/* endpoints (Vercel Cron sends this as a Bearer token).
CRON_SECRET=
# Shared salt used for hashing client IPs in the rate limiter.
RATE_LIMIT_SALT=
