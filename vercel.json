{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/api/cart/validate", "destination": "/api" },
    { "source": "/api/checkout/create-order", "destination": "/api" },
    { "source": "/api/checkout/retry-payment", "destination": "/api" },
    { "source": "/api/orders/status", "destination": "/api" },
    { "source": "/api/payments/webhook", "destination": "/api" },
    { "source": "/api/store/config", "destination": "/api" },
    { "source": "/api/contact", "destination": "/api" },
    { "source": "/api/newsletter", "destination": "/api" },
    { "source": "/api/health", "destination": "/api" },
    { "source": "/api/cron/sync-supplier", "destination": "/api" },
    { "source": "/api/admin/:path*", "destination": "/api" },
    { "source": "/", "destination": "/store/index.html" },
    { "source": "/shop", "destination": "/store/shop.html" },
    { "source": "/product/:slug", "destination": "/store/product.html?slug=:slug" },
    { "source": "/cart", "destination": "/store/cart.html" },
    { "source": "/checkout", "destination": "/store/checkout.html" },
    { "source": "/order-confirmation", "destination": "/store/order-confirmation.html" },
    { "source": "/account", "destination": "/store/account.html" },
    { "source": "/login", "destination": "/store/login.html" },
    { "source": "/register", "destination": "/store/register.html" },
    { "source": "/about", "destination": "/store/about.html" },
    { "source": "/contact", "destination": "/store/contact.html" },
    { "source": "/delivery-returns", "destination": "/store/delivery-returns.html" },
    { "source": "/faqs", "destination": "/store/faqs.html" },
    { "source": "/privacy", "destination": "/store/privacy.html" },
    { "source": "/cookies", "destination": "/store/cookies.html" },
    { "source": "/terms", "destination": "/store/terms.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/sync-supplier", "schedule": "0 3 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
